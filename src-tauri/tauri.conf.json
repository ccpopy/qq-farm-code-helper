{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQ农场 Code 获取助手",
  "version": "0.1.8",
  "identifier": "io.github.ccpopy.qqfarmcodehelper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QQ农场 Code 获取助手",
        "width": 900,
        "height": 760,
        "minWidth": 780,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ccpopy",
    "homepage": "https://github.com/ccpopy/qq-farm-code-helper",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
